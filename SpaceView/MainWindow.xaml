<Window x:Class="SpaceView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SpaceView.Models"
        Title="SpaceView — Disk Consumption &amp; Live NTFS USN Monitor"
        Icon="pack://application:,,,/Assets/SpaceView.ico"
        Width="1200"
        Height="720"
        MinWidth="820"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#334155"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#0284C7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Expand/Collapse Chevron ToggleButton -->
        <Style x:Key="TreeChevronStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="20" Height="20">
                            <Path x:Name="ChevronPath"
                                  Data="M 6,4 L 13,10 L 6,16 Z"
                                  Fill="#94A3B8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChevronPath" Property="Fill" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChevronPath" Property="Data" Value="M 4,7 L 10,14 L 16,7 Z"/>
                                <Setter TargetName="ChevronPath" Property="Fill" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context Menu for Tree Rows -->
        <ContextMenu x:Key="RowContextMenu" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1">
            <MenuItem Header="Open in Explorer" Click="MenuOpenInExplorer_Click"/>
            <MenuItem Header="Copy Full Path" Click="MenuCopyPath_Click"/>
            <Separator Background="#334155"/>
            <MenuItem Header="Properties" Click="MenuProperties_Click"/>
            <Separator Background="#334155"/>
            <MenuItem Header="Delete to Recycle Bin" Foreground="#FB7185" Click="MenuDeleteToRecycleBin_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== TOP TOOLBAR ==================== -->
        <Border Grid.Row="0"
                Background="#111827"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Drive Label -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Width="12" Height="12" CornerRadius="6" Background="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Select Drive:"
                               FontWeight="SemiBold"
                               FontSize="13.5"
                               Foreground="#E2E8F0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Drive Selector ComboBox -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox x:Name="DriveComboBox"
                              Height="38"
                              SelectionChanged="DriveComboBox_SelectionChanged"
                              Background="#1E293B"
                              Foreground="#0F172A"
                              BorderBrush="#334155"
                              VerticalContentAlignment="Center"
                              Cursor="Hand">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:DriveItemViewModel}">
                                <Grid Width="315" Margin="2,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Foreground="#0F172A"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TrayFreeSummary}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0284C7"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="1"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding UsedPercentage, Mode=OneWay}"
                                                 Height="5"
                                                 Margin="0,3,0,0"
                                                 Background="#CBD5E1"
                                                 Foreground="{Binding BarBrush}"
                                                 BorderThickness="0"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Placeholder shown when no drive is selected yet -->
                    <TextBlock x:Name="DrivePlaceholderText"
                               Text="Choose a drive to scan consumption..."
                               Foreground="#64748B"
                               FontSize="12.5"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="12,0,30,0"/>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="RescanButton"
                            Content="⟳  Rescan Drive"
                            Style="{StaticResource ToolbarButtonStyle}"
                            IsEnabled="False"
                            Click="RescanButton_Click"
                            Margin="0,0,8,0"/>
                    <Button Content="↻  Refresh Drives"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="RefreshDrivesButton_Click"/>
                </StackPanel>

                <!-- Live NTFS USN Journal Status Badge -->
                <Border Grid.Column="3"
                        x:Name="UsnStatusBadge"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="14,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="UsnStatusDot"
                                 Width="8"
                                 Height="8"
                                 Fill="#10B981"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="UsnStatusText"
                                   Text="NTFS USN Journal Monitoring Active"
                                   Foreground="#E2E8F0"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Minimize to Tray Button -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▾  Minimize to Tray"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="MinimizeToTrayButton_Click"
                            ToolTip="Hide window to the Windows System Tray"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== COLUMN HEADERS ==================== -->
        <Border Grid.Row="1"
                Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="0,0,0,1"
                Padding="12,8,28,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="FILE / FOLDER TREE" FontWeight="Bold" FontSize="11" Foreground="#94A3B8"/>
                <TextBlock Grid.Column="1" Text="% OF PARENT" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="2" Text="CONSUMPTION" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" TextAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="FILES" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" TextAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="FOLDERS" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" TextAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ==================== VIRTUALIZED TREE LIST ==================== -->
        <Grid Grid.Row="2">
            <ListBox x:Name="TreeListBox"
                     Background="#0F172A"
                     BorderThickness="0"
                     Foreground="#F8FAFC"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="TreeListBox_MouseDoubleClick">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="12,4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#1E293B"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="RowBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#1E293B"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#1E3A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TreeRowViewModel}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Indented Tree Node (Chevron + Icon + Name) -->
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Margin="{Binding IndentMargin}"
                                        VerticalAlignment="Center">
                                <ToggleButton Style="{StaticResource TreeChevronStyle}"
                                              Visibility="{Binding ExpandButtonVisibility}"
                                              IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                              Click="ExpandToggleButton_Click"
                                              Tag="{Binding}"/>

                                <!-- Folder or File Vector Icon -->
                                <Grid Width="18" Height="16" Margin="4,0,7,0" VerticalAlignment="Center">
                                    <!-- Folder Icon -->
                                    <Path Data="M 1,3 C 1,2 2,1 3,1 L 7,1 L 9,3 L 15,3 C 16,3 17,4 17,5 L 17,13 C 17,14 16,15 15,15 L 3,15 C 2,15 1,14 1,13 Z"
                                          Fill="#FBBF24">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <!-- File Icon -->
                                    <Path Data="M 3,1 L 11,1 L 15,5 L 15,15 L 3,15 Z M 10,1 L 10,6 L 15,6"
                                          Fill="#64748B">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>

                                <TextBlock Text="{Binding Name}"
                                           Foreground="#F1F5F9"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Column 1: % of Parent Bar + Text -->
                            <Grid Grid.Column="1" Margin="8,2,8,2" VerticalAlignment="Center">
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding PercentOfParent, Mode=OneWay}"
                                             Height="16"
                                             Background="#1E293B"
                                             Foreground="{Binding PercentBarBrush}"
                                             BorderThickness="0">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Border x:Name="TemplateRoot"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Rectangle x:Name="PART_Track"/>
                                                    <Border x:Name="PART_Indicator"
                                                            HorizontalAlignment="Left"
                                                            Background="{TemplateBinding Foreground}"
                                                            Opacity="0.45"
                                                            CornerRadius="4"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>
                                <TextBlock Text="{Binding PercentText}"
                                           Foreground="#F8FAFC"
                                           FontWeight="SemiBold"
                                           FontSize="11.5"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                            </Grid>

                            <!-- Column 2: Size -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SizeText}"
                                       Foreground="#E2E8F0"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>

                            <!-- Column 3: File Count -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding FileCountText}"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>

                            <!-- Column 4: Folder Count -->
                            <TextBlock Grid.Column="4"
                                       Text="{Binding FolderCountText}"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty State / Initial Prompt Overlay -->
            <Border x:Name="EmptyStateOverlay"
                    Background="#0F172A"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="M 12,18 C 12,13 44,13 44,18 L 44,38 C 44,43 12,43 12,38 Z"
                              Fill="#38BDF8"
                              Stretch="Uniform"
                              Width="28"
                              Height="28"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="OverlayTitleText"
                               Text="Select a Drive Above to Scan"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="OverlaySubtitleText"
                               Text="Choose any local volume from the drop-down menu at the top. SpaceView will scan the file/folder hierarchy and continuously monitor NTFS volumes via the USN Change Journal."
                               FontSize="13"
                               Foreground="#94A3B8"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ScanProgressBar"
                                 Width="280"
                                 Height="6"
                                 Margin="0,18,0,0"
                                 IsIndeterminate="True"
                                 Background="#1E293B"
                                 Foreground="#38BDF8"
                                 BorderThickness="0"
                                 Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== BOTTOM STATUS BAR ==================== -->
        <Border Grid.Row="3"
                Background="#111827"
                BorderBrush="#1E293B"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="0"
                           Text="Ready — Select a drive from the drop-down to begin scanning."
                           Foreground="#94A3B8"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock x:Name="StatsTextBlock"
                           Grid.Column="1"
                           Text=""
                           Foreground="#CBD5E1"
                           FontSize="12"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="20,0"/>

                <TextBlock x:Name="MemoryTextBlock"
                           Grid.Column="2"
                           Text="RAM: —"
                           Foreground="#64748B"
                           FontSize="11.5"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
