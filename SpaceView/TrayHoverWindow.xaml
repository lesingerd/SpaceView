<Window x:Class="SpaceView.TrayHoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpaceView Drives"
        Width="370"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False">
    <Window.Resources>
        <!-- Capacity bar track/indicator used by the page file bars -->
        <ControlTemplate x:Key="PageFileBarTemplate" TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Rectangle x:Name="PART_Track"/>
                    <Border x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="4"/>
                </Grid>
            </Border>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
        <Border Margin="10"
                Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.65"/>
        </Border.Effect>

        <StackPanel Margin="14,12,14,12">
            <!-- Header -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="10" Height="10" CornerRadius="5" Background="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1"
                           Text="SpaceView — Drives"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="Click icon to toggle"
                           Foreground="#64748B"
                           FontSize="10.5"
                           VerticalAlignment="Center"/>
            </Grid>

            <Border Height="1" Background="#1E293B" Margin="0,0,0,8"/>

            <!-- Drives List -->
            <ItemsControl x:Name="DrivesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E293B"
                                CornerRadius="7"
                                Padding="10,8"
                                Margin="0,0,0,7">
                            <StackPanel>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="#F1F5F9"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TrayFreeSummary}"
                                               Foreground="#38BDF8"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Margin="8,0,0,0"/>
                                </Grid>

                                <!-- Graphical Capacity Bar -->
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding UsedPercentage, Mode=OneWay}"
                                             Height="8"
                                             Background="#0F172A"
                                             Foreground="{Binding BarBrush}"
                                             BorderThickness="0">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Border x:Name="TemplateRoot"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Rectangle x:Name="PART_Track"/>
                                                    <Border x:Name="PART_Indicator"
                                                            HorizontalAlignment="Left"
                                                            Background="{TemplateBinding Foreground}"
                                                            CornerRadius="4"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>

                                <TextBlock Text="{Binding UsedVsTotalText}"
                                           Foreground="#94A3B8"
                                           FontSize="10.5"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Memory section (hidden when the system call fails) -->
            <StackPanel x:Name="MemorySection" Visibility="Collapsed">
                <Border Height="1" Background="#1E293B" Margin="0,1,0,8"/>
                <TextBlock Text="Memory"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,0,6"/>
                <Border Background="#1E293B"
                        CornerRadius="7"
                        Padding="10,8"
                        Margin="0,0,0,7">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding HeaderText}"
                                       Foreground="#F1F5F9"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AvailableSummary}"
                                       Foreground="#38BDF8"
                                       FontWeight="SemiBold"
                                       FontSize="11.5"
                                       Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Muted underlay = in use + cached, solid overlay = in use, track = free -->
                        <Grid Height="8">
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding InUseAndCachedPercentage, Mode=OneWay}"
                                         Background="#0F172A"
                                         Foreground="{Binding CachedBrush}"
                                         BorderThickness="0"
                                         Template="{StaticResource PageFileBarTemplate}"/>
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding InUsePercentage, Mode=OneWay}"
                                         Background="Transparent"
                                         Foreground="{Binding UsedBrush}"
                                         BorderThickness="0"
                                         Template="{StaticResource PageFileBarTemplate}"/>
                        </Grid>

                        <TextBlock Text="{Binding DetailText}"
                                   Foreground="#94A3B8"
                                   FontSize="10.5"
                                   Margin="0,4,0,0"/>

                        <!-- Commit charge: light underlay = peak, solid = current -->
                        <Grid Height="6" Margin="0,6,0,0">
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding CommitPeakPercentage, Mode=OneWay}"
                                         Background="#0F172A"
                                         Foreground="#7DD3FC"
                                         BorderThickness="0"
                                         Template="{StaticResource PageFileBarTemplate}"/>
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding CommitPercentage, Mode=OneWay}"
                                         Background="Transparent"
                                         Foreground="{Binding CommitBrush}"
                                         BorderThickness="0"
                                         Template="{StaticResource PageFileBarTemplate}"/>
                        </Grid>

                        <TextBlock Text="{Binding CommitText}"
                                   Foreground="#94A3B8"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Page file section (hidden when there is no page file or WMI has not answered) -->
            <StackPanel x:Name="PageFileSection" Visibility="Collapsed">
                <Border Height="1" Background="#1E293B" Margin="0,1,0,8"/>
                <TextBlock Text="Page file"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,0,6"/>
                <ItemsControl x:Name="PageFilesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B"
                                    CornerRadius="7"
                                    Padding="10,8"
                                    Margin="0,0,0,7">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#F1F5F9"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,5"/>

                                    <!-- Allocated size = 100%; light underlay = peak, solid fill = current usage -->
                                    <Grid Height="8">
                                        <ProgressBar Minimum="0" Maximum="100"
                                                     Value="{Binding PeakPercentage, Mode=OneWay}"
                                                     Background="#0F172A"
                                                     Foreground="#7DD3FC"
                                                     BorderThickness="0"
                                                     Template="{StaticResource PageFileBarTemplate}"/>
                                        <ProgressBar Minimum="0" Maximum="100"
                                                     Value="{Binding CurrentPercentage, Mode=OneWay}"
                                                     Background="Transparent"
                                                     Foreground="#38BDF8"
                                                     BorderThickness="0"
                                                     Template="{StaticResource PageFileBarTemplate}"/>
                                    </Grid>

                                    <TextBlock Text="{Binding SummaryText}"
                                               Foreground="#94A3B8"
                                               FontSize="10.5"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
        </Border>
    </Grid>
</Window>
