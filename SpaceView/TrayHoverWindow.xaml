<Window x:Class="SpaceView.TrayHoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpaceView Drives"
        Width="370"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False">
    <Window.Resources>
        <!-- Capacity bar track/indicator used by the page file bars -->
        <ControlTemplate x:Key="PageFileBarTemplate" TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Rectangle x:Name="PART_Track"/>
                    <Border x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="4"/>
                </Grid>
            </Border>
        </ControlTemplate>

        <!-- Dark tooltip -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MaxWidth" Value="260"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter>
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Margin="10"
                Background="#111827"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.65"/>
        </Border.Effect>

        <StackPanel Margin="14,12,14,12">
            <!-- Header -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="10" Height="10" CornerRadius="5" Background="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1"
                           Text="SpaceView — Drives"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="Click icon to toggle"
                           Foreground="#64748B"
                           FontSize="10.5"
                           VerticalAlignment="Center"/>
            </Grid>

            <Border Height="1" Background="#1E293B" Margin="0,0,0,8"/>

            <!-- Drives List -->
            <ItemsControl x:Name="DrivesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E293B"
                                CornerRadius="7"
                                Padding="10,8"
                                Margin="0,0,0,7">
                            <StackPanel>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="#F1F5F9"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TrayFreeSummary}"
                                               Foreground="#38BDF8"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Margin="8,0,0,0"/>
                                </Grid>

                                <!-- Graphical Capacity Bar -->
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding UsedPercentage, Mode=OneWay}"
                                             Height="8"
                                             Background="#0F172A"
                                             Foreground="{Binding BarBrush}"
                                             BorderThickness="0">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Border x:Name="TemplateRoot"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Rectangle x:Name="PART_Track"/>
                                                    <Border x:Name="PART_Indicator"
                                                            HorizontalAlignment="Left"
                                                            Background="{TemplateBinding Foreground}"
                                                            CornerRadius="4"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>

                                <TextBlock Text="{Binding UsedVsTotalText}"
                                           Foreground="#94A3B8"
                                           FontSize="10.5"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Memory section (hidden when the system call fails) -->
            <StackPanel x:Name="MemorySection" Visibility="Collapsed"
                        ToolTipService.InitialShowDelay="300"
                        ToolTipService.ShowDuration="20000">
                <Border Height="1" Background="#1E293B" Margin="0,1,0,8"/>
                <TextBlock Text="Memory"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,0,6"/>
                <Border Background="#1E293B"
                        CornerRadius="7"
                        Padding="10,8"
                        Margin="0,0,0,7">
                    <StackPanel>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding HeaderText}"
                                       ToolTip="Total RAM installed and usable by Windows."
                                       Foreground="#F1F5F9"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AvailableSummary}"
                                       ToolTip="Memory that can be given to programs right now without paging anything out. It is the cached and free memory together."
                                       Foreground="#38BDF8"
                                       FontWeight="SemiBold"
                                       FontSize="11.5"
                                       Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Muted underlay = in use + cached, solid overlay = in use, track = free -->
                        <Grid Height="8" Background="Transparent"
                              ToolTip="Solid: in use. Grey: cached. Empty: free.">
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding InUseAndCachedPercentage, Mode=OneWay}"
                                         Background="#0F172A"
                                         Foreground="{Binding CachedBrush}"
                                         BorderThickness="0"
                                         Template="{StaticResource PageFileBarTemplate}"/>
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding InUsePercentage, Mode=OneWay}"
                                         Background="Transparent"
                                         Foreground="{Binding UsedBrush}"
                                         BorderThickness="0"
                                         Template="{StaticResource PageFileBarTemplate}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontSize" Value="10.5"/>
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="{Binding InUseText}"
                                       ToolTip="Memory currently held by running programs, drivers and Windows itself. It cannot be reused until its owner frees it."/>
                            <TextBlock Text="  •  "/>
                            <TextBlock Text="{Binding CachedText}"
                                       ToolTip="Recently used file and program data that Windows keeps in RAM to speed things up. It is handed to programs instantly when they need it."/>
                            <TextBlock Text="  •  "/>
                            <TextBlock Text="{Binding FreeText}"
                                       ToolTip="Memory holding nothing at all. Windows keeps this small on purpose, because unused RAM is wasted RAM."/>
                        </StackPanel>

                        <!-- Commit charge: light underlay = peak, solid = current -->
                        <Grid Height="6" Margin="0,6,0,0" Background="Transparent"
                              ToolTip="Solid: committed now. Light: peak since startup. Full width is the commit limit.">
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding CommitPeakPercentage, Mode=OneWay}"
                                         Background="#0F172A"
                                         Foreground="#7DD3FC"
                                         BorderThickness="0"
                                         Template="{StaticResource PageFileBarTemplate}"/>
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding CommitPercentage, Mode=OneWay}"
                                         Background="Transparent"
                                         Foreground="{Binding CommitBrush}"
                                         BorderThickness="0"
                                         Template="{StaticResource PageFileBarTemplate}"/>
                        </Grid>

                        <WrapPanel Margin="0,4,0,0">
                            <WrapPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontSize" Value="10.5"/>
                                </Style>
                            </WrapPanel.Resources>
                            <TextBlock Text="{Binding CommittedText}"
                                       ToolTip="Memory that programs have reserved and Windows has promised to back with RAM or the page file. If it reaches the limit, programs can fail to allocate memory."/>
                            <TextBlock Text=" "/>
                            <TextBlock Text="{Binding CommitLimitText}"
                                       ToolTip="The most memory Windows can promise: physical RAM plus the current page file size. A larger page file raises it."/>
                            <TextBlock Text="  •  "/>
                            <TextBlock Text="{Binding PeakText}"
                                       ToolTip="The highest committed total since Windows started. It can sit above today's limit if the page file was larger earlier."/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Page file section (hidden when there is no page file or WMI has not answered) -->
            <StackPanel x:Name="PageFileSection" Visibility="Collapsed">
                <Border Height="1" Background="#1E293B" Margin="0,1,0,8"/>
                <TextBlock Text="Page file"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,0,6"/>
                <ItemsControl x:Name="PageFilesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B"
                                    CornerRadius="7"
                                    Padding="10,8"
                                    Margin="0,0,0,7">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#F1F5F9"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,5"/>

                                    <!-- Allocated size = 100%; light underlay = peak, solid fill = current usage -->
                                    <Grid Height="8">
                                        <ProgressBar Minimum="0" Maximum="100"
                                                     Value="{Binding PeakPercentage, Mode=OneWay}"
                                                     Background="#0F172A"
                                                     Foreground="#7DD3FC"
                                                     BorderThickness="0"
                                                     Template="{StaticResource PageFileBarTemplate}"/>
                                        <ProgressBar Minimum="0" Maximum="100"
                                                     Value="{Binding CurrentPercentage, Mode=OneWay}"
                                                     Background="Transparent"
                                                     Foreground="#38BDF8"
                                                     BorderThickness="0"
                                                     Template="{StaticResource PageFileBarTemplate}"/>
                                    </Grid>

                                    <TextBlock Text="{Binding SummaryText}"
                                               Foreground="#94A3B8"
                                               FontSize="10.5"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
        </Border>
    </Grid>
</Window>
